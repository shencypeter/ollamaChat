<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <VisualStudioNpmExecutable Condition="'$(VisualStudioNpmExecutable)' == ''">$(MSBuildExtensionsPath)\Microsoft\VisualStudio\NodeJs\npm.cmd</VisualStudioNpmExecutable>
    <NpmExecutable Condition="'$(NpmExecutable)' == '' And Exists('$(VisualStudioNpmExecutable)')">$(VisualStudioNpmExecutable)</NpmExecutable>
    <NpmExecutable Condition="'$(NpmExecutable)' == ''">npm</NpmExecutable>
    <NpmNodeDirectory Condition="'$(NpmNodeDirectory)' == '' And '$(NpmExecutable)' == '$(VisualStudioNpmExecutable)'">$([System.IO.Path]::GetDirectoryName('$(VisualStudioNpmExecutable)'))</NpmNodeDirectory>
    <NpmEnvironmentVariables Condition="'$(NpmNodeDirectory)' != ''">PATH=$([MSBuild]::Escape('$(NpmNodeDirectory);$(PATH)'))</NpmEnvironmentVariables>
    <DefaultItemExcludes>$(DefaultItemExcludes);.codex-build/**;ClientApp/node_modules/**;artifacts/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="Configuration\Ollama\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageReference Include="LangChain.Core" Version="0.17.0" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Npgsql" Version="8.0.8" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.6" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Content Remove="ClientApp\**\*;appsettings.Local.json;Database\**\*;wwwroot\portal\**\*" />
    <None Remove="ClientApp\node_modules\**\*" />
    <Content Include="Database\**\*.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Remove="tests\**\*" />
    <None Remove="tests\**\*" />
  </ItemGroup>

  <Target Name="RestoreVueDependencies"
          Inputs="$(MSBuildProjectDirectory)\ClientApp\package-lock.json"
          Outputs="$(MSBuildProjectDirectory)\ClientApp\node_modules\.package-lock.json"
          Condition="'$(SkipFrontendBuild)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\ClientApp" Command="&quot;$(NpmExecutable)&quot; ci --no-audit --no-fund" EnvironmentVariables="$(NpmEnvironmentVariables)" Condition="'$(SkipFrontendBuild)' != 'true'" />
  </Target>

  <Target Name="BuildVue"
          BeforeTargets="Build"
          DependsOnTargets="RestoreVueDependencies"
          Condition="'$(SkipFrontendBuild)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\ClientApp" Command="&quot;$(NpmExecutable)&quot; run build" EnvironmentVariables="$(NpmEnvironmentVariables)" />
  </Target>

  <Target Name="BuildVueForPublish"
          BeforeTargets="_HandleFileConflictsForPublish"
          DependsOnTargets="BuildVue">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('wwwroot/portal/')) Or $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('wwwroot\portal\'))" />
      <VuePublishFiles Include="wwwroot/portal/**/*" />
      <ResolvedFileToPublish Include="@(VuePublishFiles->'%(FullPath)')">
        <RelativePath>wwwroot/portal/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
